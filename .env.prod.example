# Copy to /opt/cicd-lab-2/.env.prod on the VPS. chmod 600 .env.prod.
# Use a lowercase GitHub user/organization, without angle brackets.
GHCR_OWNER=REPLACE_WITH_LOWERCASE_GITHUB_OWNER
POSTGRES_DB=quiz_lab
POSTGRES_USER=quiz
# Set a strong password here, never in GitHub YAML or an image.
# A hex password avoids Bash/Compose quoting differences.
POSTGRES_PASSWORD=
FRONTEND_PORT=8082
BACKEND_PORT=8002
BIND_ADDRESS=0.0.0.0
# IMAGE_TAG is supplied by deploy.sh / rollback.sh, not maintained here.
